{
  "name": "mhm-note",
  "version": "0.1.0",
  "description": "MHM NOTE - encrypted notes and passwords",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:sync": "cap sync android",
    "electron:dist": "electron-builder --win nsis portable --publish never"
  },
  "keywords": [],
  "author": "Mahmoud",
  "license": "ISC",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-native-biometric": "^8.9.3",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "hash-wasm": "^4.13.0",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.mhm.note",
    "productName": "MHM NOTE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "MHM-NOTE-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MHM NOTE",
      "artifactName": "MHM-NOTE-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MHM-NOTE-Portable-${version}.${ext}"
    }
  }
}
